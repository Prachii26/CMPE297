# Copy to .env and fill in. .env is gitignored; never commit a real key.

GOOGLE_GENAI_USE_VERTEXAI=FALSE

# AI Studio key. If GEMINI_API_KEY is already exported, agent.py maps it across
# and you can leave this blank.
GOOGLE_API_KEY=

# Optional overrides
# LEAD_RESEARCH_MODEL=gemini-2.5-flash
# How many scorer/critic iterations. Each costs 2 model calls. Default 2.
# LEAD_RESEARCH_MAX_LOOPS=2
