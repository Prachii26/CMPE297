# Copy to .env and fill in. .env is gitignored; never commit a real key.

GOOGLE_GENAI_USE_VERTEXAI=FALSE

# AI Studio key. If GEMINI_API_KEY is already exported, agent.py maps it across
# and you can leave this blank.
GOOGLE_API_KEY=

# --------------------------------------------------------------------------
# One model per stage
#
# Free-tier quota is 20 requests/day PER MODEL, and this pipeline spends
# 20-35 calls in a run. Two separate reasons to spread it:
#
#   1. The three researchers run SIMULTANEOUSLY. They must never share a
#      model, or the per-minute limit fires immediately.
#   2. The sequential stages do not contend with each other, but they do share
#      the daily budget, so spreading them raises the ceiling for a whole run.
#
# Check which models still have quota before a demo run:
#   .\.venv\Scripts\python.exe -c "import os,json,urllib.request as u; k=os.environ['GEMINI_API_KEY']; [print(m, (lambda: (u.urlopen(u.Request(f'https://generativelanguage.googleapis.com/v1beta/models/{m}:generateContent?key={k}', data=json.dumps({'contents':[{'parts':[{'text':'hi'}]}],'generationConfig':{'maxOutputTokens':1}}).encode(), headers={'Content-Type':'application/json'}), timeout=60) and 'OK'))() if True else '') for m in ['gemini-3-flash-preview','gemini-3.5-flash-lite','gemini-3.1-flash-lite','gemini-flash-lite-latest','gemini-3.5-flash','gemini-flash-latest']]"
#
# ...or just run the pipeline and read the 429s. Re-point any dry stage below.
# --------------------------------------------------------------------------

# LEAD_RESEARCH_PLANNER_MODEL=gemini-3-flash-preview
# Comma separated, one per researcher, in order: market, firmographic, signals.
# LEAD_RESEARCH_RESEARCHER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# LEAD_RESEARCH_SCORER_MODEL=gemini-3.5-flash-lite
# LEAD_RESEARCH_CRITIC_MODEL=gemini-3.1-flash-lite
# LEAD_RESEARCH_CRITIC_SEARCH_MODEL=gemini-flash-lite-latest
# LEAD_RESEARCH_WRITER_MODEL=gemini-3-flash-preview

# Fallback for any stage without its own override.
# LEAD_RESEARCH_MODEL=gemini-3-flash-preview

# Critic iterations. Each costs 2 model calls.
# LEAD_RESEARCH_MAX_LOOPS=2

# Seconds between DuckDuckGo calls. Below ~6 it starts answering with HTTP 202
# and an empty body instead of results.
# LEAD_RESEARCH_SEARCH_GAP=6
# LEAD_RESEARCH_SEARCH_TIMEOUT=20
