# Copy to .env and fill in. .env is gitignored; never commit a real key.

GOOGLE_GENAI_USE_VERTEXAI=FALSE

# AI Studio key. If GEMINI_API_KEY is already exported, agent.py maps it across.
GOOGLE_API_KEY=

# Optional overrides
# CODE_REVIEW_MODEL=gemini-flash-latest
# CODE_REVIEW_MAX_FIX_ATTEMPTS=3
# Files the agent may read or write. Defaults to this project folder.
# CODE_REVIEW_SANDBOX=.
