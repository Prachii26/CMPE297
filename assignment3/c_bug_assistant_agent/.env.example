# Copy to .env and fill in. .env is gitignored; never commit a real key.

# AI Studio (local runs). Keep FALSE so ADK does not try Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Your AI Studio key. If GEMINI_API_KEY is already exported in your shell,
# agent.py maps it onto GOOGLE_API_KEY automatically and you can leave this blank.
GOOGLE_API_KEY=

# Optional overrides
# BUG_ASSISTANT_MODEL=gemini-2.5-flash
# BUG_DB_PATH=./voltloop_bugs.db
