# Copy to .env and fill in. .env is gitignored; never commit a real key.

GOOGLE_GENAI_USE_VERTEXAI=FALSE

# One AI Studio key serves both the ADK agent (GOOGLE_API_KEY) and the Gemini
# CLI subprocess (GEMINI_API_KEY). agent.py copies whichever you set to the other.
GOOGLE_API_KEY=

# Optional overrides
# GEMINI_CLI_AGENT_MODEL=gemini-2.5-flash
# Folder the CLI may run in. Defaults to ./sandbox. Paths outside are refused.
# GEMINI_CLI_SANDBOX=./sandbox
# GEMINI_CLI_TIMEOUT=120
# GEMINI_CLI_MAX_OUTPUT=16000
